<!-- TOOL MODAL -->

<div id="toolModal" class="modal-bg hidden">
  <div class="modal tool-modal">

    <div class="modal-header">
      <h2 id="toolTitle">Tool</h2>
      <button class="close" onclick="closeTool()">×</button>
    </div>

    <div id="toolContent"></div>

  </div>
</div>


<script>
/* =========================================================
   SUPABASE
========================================================= */

const SUPABASE_URL = "https://vabrpwyjsowbgzoktxvy.supabase.co";

const SUPABASE_KEY =
  "sb_publishable_AJ5Wbwx4q2yAkaaZUl-bvg_dTDNYDbP";

const supabaseClient =
  window.supabase.createClient(
    SUPABASE_URL,
    SUPABASE_KEY
  );


/* =========================================================
   AUTH UI
========================================================= */

function openAuth() {
  document.getElementById("authModal").classList.remove("hidden");
}

function closeAuth() {
  document.getElementById("authModal").classList.add("hidden");
  clearAuthMessage();
}

function showSignup() {
  document.getElementById("authTitle").textContent = "Create Account";
  document.getElementById("signupFields").classList.remove("hidden");
  document.getElementById("loginFields").classList.add("hidden");
  clearAuthMessage();
}

function showLogin() {
  document.getElementById("authTitle").textContent = "Login";
  document.getElementById("signupFields").classList.add("hidden");
  document.getElementById("loginFields").classList.remove("hidden");
  clearAuthMessage();
}

function authMessage(message, type) {
  const box = document.getElementById("authMessage");

  box.textContent = message;
  box.className = "auth-message " + type;
}

function clearAuthMessage() {
  const box = document.getElementById("authMessage");

  box.textContent = "";
  box.className = "auth-message";
}


/* =========================================================
   REGISTER
========================================================= */

async function signup() {

  const email =
    document.getElementById("signupEmail").value.trim();

  const password =
    document.getElementById("signupPassword").value;

  const confirm =
    document.getElementById("signupConfirm").value;

  if (!email || !password || !confirm) {
    authMessage("Please fill in all fields.", "error");
    return;
  }

  if (password.length < 6) {
    authMessage(
      "Password must be at least 6 characters.",
      "error"
    );
    return;
  }

  if (password !== confirm) {
    authMessage(
      "Passwords do not match.",
      "error"
    );
    return;
  }

  authMessage("Creating your account...", "success");

  const { data, error } =
    await supabaseClient.auth.signUp({
      email: email,
      password: password,
      options: {
        emailRedirectTo:
          window.location.origin +
          window.location.pathname
      }
    });

  if (error) {
    authMessage(error.message, "error");
    return;
  }

  /*
    If Supabase requires email confirmation,
    there will normally be no active session here.
  */

  if (!data.session) {

    authMessage(
      "Account created. Please check your email and click the confirmation link before logging in.",
      "success"
    );

    document.getElementById("signupPassword").value = "";
    document.getElementById("signupConfirm").value = "";

    return;
  }

  await afterLogin(data.user);
}


/* =========================================================
   LOGIN
========================================================= */

async function login() {

  const email =
    document.getElementById("loginEmail").value.trim();

  const password =
    document.getElementById("loginPassword").value;

  if (!email || !password) {
    authMessage(
      "Enter your email and password.",
      "error"
    );
    return;
  }

  authMessage("Logging in...", "success");

  const { data, error } =
    await supabaseClient.auth.signInWithPassword({
      email: email,
      password: password
    });

  if (error) {

    if (
      error.message.toLowerCase().includes("email not confirmed")
    ) {
      authMessage(
        "Please confirm your email address before logging in.",
        "error"
      );
    } else {
      authMessage(error.message, "error");
    }

    return;
  }

  await afterLogin(data.user);
}


/* =========================================================
   AFTER LOGIN
========================================================= */

async function afterLogin(user) {

  if (!user) return;

  try {

    await supabaseClient
      .from("profiles")
      .upsert(
        {
          id: user.id
        },
        {
          onConflict: "id"
        }
      );

  } catch (e) {
    console.log("Profile error:", e);
  }

  document.getElementById("authModal")
    .classList.add("hidden");

  updateAuthUI(user);
}


/* =========================================================
   LOGOUT
========================================================= */

async function logout() {

  await supabaseClient.auth.signOut();

  updateAuthUI(null);

  closeTool();
}


/* =========================================================
   AUTH UI UPDATE
========================================================= */

function updateAuthUI(user) {

  const loginButton =
    document.getElementById("authButton");

  const logoutButton =
    document.getElementById("logoutButton");

  const email =
    document.getElementById("userEmail");

  const notice =
    document.getElementById("loginNotice");

  const status =
    document.getElementById("accountStatus");

  if (user) {

    loginButton.classList.add("hidden");
    logoutButton.classList.remove("hidden");

    email.textContent =
      user.email || "";

    notice.classList.add("hidden");

    status.textContent =
      user.email || "Logged in";

  } else {

    loginButton.classList.remove("hidden");
    logoutButton.classList.add("hidden");

    email.textContent = "";

    notice.classList.remove("hidden");

    status.textContent =
      "Not logged in";
  }
}


/* =========================================================
   CHECK CURRENT SESSION
========================================================= */

async function checkSession() {

  const { data } =
    await supabaseClient.auth.getSession();

  updateAuthUI(data.session?.user || null);

  supabaseClient.auth.onAuthStateChange(
    async (_event, session) => {
      updateAuthUI(session?.user || null);
    }
  );
}


/* =========================================================
   TOOL ACCESS
========================================================= */

async function guardTool(toolName) {

  const { data } =
    await supabaseClient.auth.getSession();

  if (!data.session) {

    openAuth();

    authMessage(
      "Please login or register before using NaijaTool.",
      "error"
    );

    return false;
  }

  /*
    Record usage.
    RLS allows authenticated users to insert
    their own user_id.
  */

  try {

    await supabaseClient
      .from("tool_usage")
      .insert({
        user_id: data.session.user.id,
        tool_name: toolName
      });

  } catch (e) {
    console.log("Usage tracking:", e);
  }

  return true;
}


/* =========================================================
   TOOL MODAL
========================================================= */

async function openTool(tool) {

  const allowed =
    await guardTool(tool);

  if (!allowed) return;

  const modal =
    document.getElementById("toolModal");

  const title =
    document.getElementById("toolTitle");

  const content =
    document.getElementById("toolContent");

  modal.classList.remove("hidden");

  content.innerHTML = "";

  if (tool === "calculator") {

    title.textContent = "🧮 Calculator";

    content.innerHTML = `
      <input id="calcDisplay"
             class="calc-display"
             value=""
             readonly>

      <div class="calculator">

        <button class="calc-btn" onclick="calcClear()">C</button>
        <button class="calc-btn" onclick="calcBack()">⌫</button>
        <button class="calc-btn" onclick="calcAdd('%')">%</button>
        <button class="calc-btn" onclick="calcAdd('/')">÷</button>

        <button class="calc-btn" onclick="calcAdd('7')">7</button>
        <button class="calc-btn" onclick="calcAdd('8')">8</button>
        <button class="calc-btn" onclick="calcAdd('9')">9</button>
        <button class="calc-btn" onclick="calcAdd('*')">×</button>

        <button class="calc-btn" onclick="calcAdd('4')">4</button>
        <button class="calc-btn" onclick="calcAdd('5')">5</button>
        <button class="calc-btn" onclick="calcAdd('6')">6</button>
        <button class="calc-btn" onclick="calcAdd('-')">−</button>

        <button class="calc-btn" onclick="calcAdd('1')">1</button>
