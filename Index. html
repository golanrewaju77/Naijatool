<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="theme-color" content="#10142b">
  <meta name="description" content="NaijaTool - Free online tools for everyday calculations and utilities.">
  <title>NaijaTool - Free Online Tools</title>

  <script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>

  <style>
    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    :root {
      --bg: #080b18;
      --card: #11162a;
      --card2: #171d35;
      --text: #f5f7ff;
      --muted: #aab1c8;
      --primary: #6c63ff;
      --primary2: #8b5cf6;
      --border: rgba(255,255,255,.09);
      --success: #22c55e;
      --danger: #ef4444;
    }

    body.light {
      --bg: #f4f6fb;
      --card: #ffffff;
      --card2: #eef1f8;
      --text: #101426;
      --muted: #596174;
      --border: rgba(0,0,0,.09);
    }

    body {
      font-family: Arial, Helvetica, sans-serif;
      background:
        radial-gradient(circle at top left, rgba(108,99,255,.18), transparent 35%),
        var(--bg);
      color: var(--text);
      min-height: 100vh;
      transition: .25s;
    }

    button,
    input,
    select {
      font: inherit;
    }

    button {
      cursor: pointer;
    }

    .hidden {
      display: none !important;
    }

    header {
      position: sticky;
      top: 0;
      z-index: 50;
      backdrop-filter: blur(18px);
      background: rgba(8,11,24,.84);
      border-bottom: 1px solid var(--border);
    }

    body.light header {
      background: rgba(244,246,251,.88);
    }

    .nav {
      max-width: 1150px;
      margin: auto;
      min-height: 70px;
      padding: 12px 18px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 15px;
    }

    .logo {
      font-size: 23px;
      font-weight: 800;
      color: white;
      text-decoration: none;
    }

    body.light .logo {
      color: var(--text);
    }

    .logo span {
      color: #8b7cff;
    }

    .nav-right {
      display: flex;
      align-items: center;
      gap: 8px;
    }

    .nav-btn {
      border: 1px solid var(--border);
      background: var(--card);
      color: var(--text);
      padding: 10px 13px;
      border-radius: 10px;
    }

    .nav-btn:hover {
      border-color: var(--primary);
    }

    .user-pill {
      color: var(--muted);
      font-size: 13px;
      max-width: 170px;
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
    }

    .hero {
      max-width: 1150px;
      margin: auto;
      padding: 65px 18px 35px;
      text-align: center;
    }

    .hero h1 {
      font-size: clamp(35px, 7vw, 64px);
      line-height: 1.05;
      margin-bottom: 18px;
      background: linear-gradient(90deg,#fff,#9b91ff);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
    }

    .hero p {
      color: var(--muted);
      max-width: 650px;
      margin: auto;
      line-height: 1.7;
    }

    .auth-required {
      margin-top: 22px;
      display: inline-block;
      padding: 12px 18px;
      border-radius: 12px;
      background: rgba(108,99,255,.14);
      border: 1px solid rgba(108,99,255,.35);
      color: #c8c3ff;
      font-size: 14px;
    }

    .tools {
      max-width: 1150px;
      margin: auto;
      padding: 25px 18px 70px;
      display: grid;
      grid-template-columns: repeat(auto-fit,minmax(210px,1fr));
      gap: 16px;
    }

    .tool-card {
      border: 1px solid var(--border);
      background: linear-gradient(145deg,var(--card),var(--card2));
      border-radius: 18px;
      padding: 22px;
      min-height: 165px;
      transition: .2s;
    }

    .tool-card:hover {
      transform: translateY(-3px);
      border-color: rgba(108,99,255,.55);
    }

    .tool-icon {
      font-size: 30px;
      margin-bottom: 14px;
    }

    .tool-card h3 {
      margin-bottom: 8px;
    }

    .tool-card p {
      color: var(--muted);
      font-size: 13px;
      line-height: 1.5;
      margin-bottom: 15px;
    }

    .primary {
      width: 100%;
      border: 0;
      padding: 11px 15px;
      border-radius: 10px;
      color: white;
      background: linear-gradient(135deg,var(--primary),var(--primary2));
      font-weight: 700;
    }

    .secondary {
      border: 1px solid var(--border);
      padding: 11px 15px;
      border-radius: 10px;
      color: var(--text);
      background: var(--card2);
    }

    .settings {
      max-width: 700px;
      margin: 0 auto 70px;
      padding: 0 18px;
    }

    .settings-box {
      border: 1px solid var(--border);
      background: var(--card);
      padding: 22px;
      border-radius: 18px;
    }

    .settings-box h2 {
      margin-bottom: 18px;
    }

    .setting-row {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 15px;
      padding: 15px 0;
      border-bottom: 1px solid var(--border);
    }

    .setting-row:last-child {
      border-bottom: 0;
    }

    .setting-row small {
      display: block;
      color: var(--muted);
      margin-top: 4px;
    }

    .switch {
      width: 50px;
      height: 28px;
      border-radius: 30px;
      background: #30364e;
      position: relative;
      border: 0;
      flex-shrink: 0;
    }

    .switch::after {
      content: "";
      position: absolute;
      width: 22px;
      height: 22px;
      border-radius: 50%;
      background: white;
      left: 3px;
      top: 3px;
      transition: .2s;
    }

    body.light .switch {
      background: var(--primary);
    }

    body.light .switch::after {
      left: 25px;
    }

    footer {
      border-top: 1px solid var(--border);
      text-align: center;
      padding: 30px 18px;
      color: var(--muted);
      font-size: 13px;
    }

    .footer-links {
      margin-top: 10px;
      display: flex;
      justify-content: center;
      gap: 15px;
      flex-wrap: wrap;
    }

    .footer-links a {
      color: #928aff;
      text-decoration: none;
    }

    /* Modal */

    .modal-bg {
      position: fixed;
      inset: 0;
      background: rgba(0,0,0,.72);
      backdrop-filter: blur(7px);
      z-index: 100;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 18px;
    }

    .modal {
      width: 100%;
      max-width: 430px;
      background: var(--card);
      border: 1px solid var(--border);
      border-radius: 20px;
      padding: 25px;
      box-shadow: 0 25px 80px rgba(0,0,0,.4);
    }

    .modal-header {
      display: flex;
      justify-content: space-between;
      gap: 15px;
      align-items: center;
      margin-bottom: 20px;
    }

    .close {
      background: transparent;
      border: 0;
      color: var(--muted);
      font-size: 26px;
    }

    .field {
      margin-bottom: 13px;
    }

    .field label {
      display: block;
      margin-bottom: 7px;
      font-size: 13px;
      color: var(--muted);
    }

    .field input,
    .field select {
      width: 100%;
      padding: 12px;
      border-radius: 10px;
      border: 1px solid var(--border);
      background: var(--card2);
      color: var(--text);
      outline: none;
    }

    .field input:focus,
    .field select:focus {
      border-color: var(--primary);
    }

    .auth-message {
      padding: 11px;
      border-radius: 10px;
      font-size: 13px;
      margin-bottom: 13px;
      display: none;
    }

    .auth-message.error {
      display: block;
      background: rgba(239,68,68,.12);
      color: #ff9b9b;
      border: 1px solid rgba(239,68,68,.25);
    }

    .auth-message.success {
      display: block;
      background: rgba(34,197,94,.12);
      color: #8ff0ae;
      border: 1px solid rgba(34,197,94,.25);
    }

    .auth-switch {
      text-align: center;
      color: var(--muted);
      font-size: 13px;
      margin-top: 15px;
    }

    .auth-switch button {
      border: 0;
      background: none;
      color: #9b91ff;
      font-weight: bold;
    }

    /* Tool modal */

    .tool-modal {
      max-width: 500px;
    }

    .result {
      margin-top: 15px;
      padding: 14px;
      border-radius: 12px;
      background: var(--card2);
      border: 1px solid var(--border);
      line-height: 1.6;
      word-break: break-word;
    }

    .calculator {
      display: grid;
      grid-template-columns: repeat(4,1fr);
      gap: 8px;
      margin-top: 15px;
    }

    .calc-display {
      width: 100%;
      padding: 15px;
      border-radius: 12px;
      border: 1px solid var(--border);
      background: var(--card2);
      color: var(--text);
      font-size: 24px;
      text-align: right;
      margin-bottom: 10px;
    }

    .calc-btn {
      border: 1px solid var(--border);
      background: var(--card2);
      color: var(--text);
      padding: 15px 8px;
      border-radius: 10px;
      font-size: 17px;
    }

    .calc-btn:hover {
      border-color: var(--primary);
    }

    .calc-equal {
      background: var(--primary);
      color: white;
    }

    @media(max-width:600px) {
      .nav {
        padding: 10px 12px;
      }

      .logo {
        font-size: 20px;
      }

      .user-pill {
        display: none;
      }

      .hero {
        padding-top: 45px;
      }

      .tools {
        grid-template-columns: repeat(2,1fr);
        gap: 10px;
        padding-left: 12px;
        padding-right: 12px;
      }

      .tool-card {
        padding: 16px;
        min-height: 155px;
      }

      .tool-card h3 {
        font-size: 15px;
      }

      .tool-card p {
        font-size: 12px;
      }
    }

    @media(max-width:390px) {
      .tools {
        grid-template-columns: 1fr;
      }
    }
  </style>
</head>

<body>

<header>
  <nav class="nav">
    <a class="logo" href="#">Naija<span>Tool</span></a>

    <div class="nav-right">
      <span id="userEmail" class="user-pill"></span>
      <button id="authButton" class="nav-btn" onclick="openAuth()">Login</button>
      <button id="logoutButton" class="nav-btn hidden" onclick="logout()">Logout</button>
    </div>
  </nav>
</header>

<main>

  <section class="hero">
    <h1>NaijaTool</h1>
    <p>
