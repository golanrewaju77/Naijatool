/* =========================================================
   CALCULATOR
========================================================= */

function calcAdd(value) {

  const display =
    document.getElementById("calcDisplay");

  display.value += value;
}


function calcClear() {

  document.getElementById("calcDisplay")
    .value = "";
}


function calcBack() {

  const display =
    document.getElementById("calcDisplay");

  display.value =
    display.value.slice(0,-1);
}


function calcEqual() {

  const display =
    document.getElementById("calcDisplay");

  try {

    if (!/^[0-9+\-*/%.() ]+$/.test(display.value)) {
      throw new Error();
    }

    const result =
      Function(
        '"use strict"; return (' +
        display.value +
        ')'
      )();

    if (!Number.isFinite(result)) {
      throw new Error();
    }

    display.value = result;

  } catch {

    display.value = "Error";
  }
}


/* =========================================================
   PERCENTAGE
========================================================= */

function calculatePercentage() {

  const percent =
    Number(document.getElementById("percentValue").value);

  const number =
    Number(document.getElementById("percentNumber").value);

  if (
    !Number.isFinite(percent) ||
    !Number.isFinite(number)
  ) {

    document.getElementById("percentageResult")
      .innerHTML =
      `<div class="result">Enter valid numbers.</div>`;

    return;
  }

  const result =
    (percent / 100) * number;

  document.getElementById("percentageResult")
    .innerHTML =
    `<div class="result">
      ${percent}% of ${number} = <strong>${result}</strong>
    </div>`;
}


/* =========================================================
   AGE
========================================================= */

function calculateAge() {

  const input =
    document.getElementById("birthDate").value;

  if (!input) {

    document.getElementById("ageResult")
      .innerHTML =
      `<div class="result">Select your date of birth.</div>`;

    return;
  }

  const birth =
    new Date(input + "T00:00:00");

  const today =
    new Date();

  if (birth > today) {

    document.getElementById("ageResult")
      .innerHTML =
      `<div class="result">Date of birth cannot be in the future.</div>`;

    return;
  }

  let years =
    today.getFullYear() -
    birth.getFullYear();

  let months =
    today.getMonth() -
    birth.getMonth();

  let days =
    today.getDate() -
    birth.getDate();

  if (days < 0) {
    months--;
    days += new Date(
      today.getFullYear(),
      today.getMonth(),
      0
    ).getDate();
  }

  if (months < 0) {
    years--;
    months += 12;
  }

  document.getElementById("ageResult")
    .innerHTML =
    `<div class="result">
      You are <strong>${years}</strong> years,
      <strong>${months}</strong> months and
      <strong>${days}</strong> days old.
    </div>`;
}


/* =========================================================
   PASSWORD GENERATOR
========================================================= */

function generatePassword() {

  let length =
    Number(document.getElementById("passwordLength").value);

  if (!Number.isFinite(length)) {
    length = 16;
  }

  length =
    Math.max(6, Math.min(100, Math.floor(length)));

  const chars =
    "ABCDEFGHIJKLMNOPQRSTUVWXYZ" +
    "abcdefghijklmnopqrstuvwxyz" +
    "0123456789" +
    "!@#$%^&*()-_=+";

  const array =
    new Uint32Array(length);

  crypto.getRandomValues(array);

  let password = "";

  for (let i = 0; i < length; i++) {
    password +=
      chars[array[i] % chars.length];
  }

  document.getElementById("passwordResult")
    .innerHTML =
    `<div class="result">
      <strong style="word-break:break-all">${escapeHTML(password)}</strong>

      <br><br>

      <button class="secondary"
              onclick="copyPassword('${escapeJS(password)}')">
        Copy Password
      </button>
    </div>`;
}


function copyPassword(password) {

  navigator.clipboard
    .writeText(password)
    .then(() => {

      alert("Password copied.");

    })
    .catch(() => {

      alert("Copy failed. Please copy it manually.");
    });
}


/* =========================================================
   UNIT CONVERTER
========================================================= */

function updateUnitLabels() {

  const type =
    document.getElementById("unitType").value;

  const label =
    document.getElementById("unitLabel");

  const labels = {

    "km-mi": "Kilometers",

    "mi-km": "Miles",

    "kg-lb": "Kilograms",

    "lb-kg": "Pounds",

    "c-f": "Celsius",

    "f-c": "Fahrenheit"
  };

  label.textContent =
    labels[type];
}


function convertUnit() {

  const value =
    Number(document.getElementById("unitValue").value);

  const type =
    document.getElementById("unitType").value;

  if (!Number.isFinite(value)) {

    document.getElementById("unitResult")
      .innerHTML =
      `<div class="result">Enter a valid number.</div>`;

    return;
  }

  let result;
  let unit;

  switch (type) {

    case "km-mi":
      result = value * 0.621371;
      unit = "miles";
      break;

    case "mi-km":
      result = value * 1.609344;
      unit = "kilometers";
      break;

    case "kg-lb":
      result = value * 2.2046226218;
      unit = "pounds";
      break;

    case "lb-kg":
      result = value * 0.45359237;
      unit = "kilograms";
      break;

    case "c-f":
      result = (value * 9 / 5) + 32;
      unit = "°F";
      break;

    case "f-c":
      result = (value - 32) * 5 / 9;
      unit = "°C";
      break;
  }

  document.getElementById("unitResult")
    .innerHTML =
    `<div class="result">
      Result: <strong>${Number(result.toFixed(6))} ${unit}</strong>
    </div>`;
}


/* =========================================================
   NUMBER CHECKER
========================================================= */

function checkNumber() {

  const value =
    Number(document.getElementById("numberValue").value);

  if (!Number.isFinite(value)) {

    document.getElementById("numberResult")
      .innerHTML =
      `<div class="result">Enter a valid number.</div>`;

    return;
  }

  let answer;

  if (Number.isInteger(value)) {

    answer =
      value % 2 === 0
      ? "Even number"
      : "Odd number";

  } else {

    answer =
      "This is not an integer.";
  }

  document.getElementById("numberResult")
    .innerHTML =
    `<div class="result">
      <strong>${value}</strong> — ${answer}
    </div>`;
}


/* =========================================================
   TEXT COUNTER
========================================================= */

function countText() {

  const text =
    document.getElementById("textValue").value;

  const characters =
    text.length;

  const words =
    text.trim()
      ? text.trim().split(/\s+/).length
      : 0;

  const lines =
    text
      ? text.split(/\n/).length
      : 0;

  document.getElementById("textResult")
    .innerHTML =
    `
      Characters: <strong>${characters}</strong><br>
      Words: <strong>${words}</strong><br>
      Lines: <strong>${lines}</strong>
    `;
}


/* =========================================================
   CURRENCY
========================================================= */

function convertCurrency() {

  const amount =
    Number(document.getElementById("currencyAmount").value);

  const rate =
    Number(document.getElementById("currencyRate").value);

  if (
    !Number.isFinite(amount) ||
    !Number.isFinite(rate)
  ) {

    document.getElementById("currencyResult")
      .innerHTML =
      `<div class="result">Enter valid numbers.</div>`;

    return;
  }

  const result =
    amount * rate;

  document.getElementById("currencyResult")
    .innerHTML =
    `<div class="result">
      Result: <strong>${result.toLocaleString()}</strong>
    </div>`;
}


